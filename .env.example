NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Só para o servidor (Route Handlers). NUNCA prefixar com NEXT_PUBLIC_.
# Painel do Supabase → Project Settings → API → chave "service_role".
# Usada pela secretária IA para ler a chave da Groq guardada em Configurações.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
